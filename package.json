{
  "name": "echoloop",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "golden": "vitest run --config vitest.config.ts tests/golden",
    "golden:record": "vitest run --config vitest.record.config.ts",
    "verify": "npm run format && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "pixi.js": "8"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "26",
    "eslint": "latest",
    "fast-check": "latest",
    "prettier": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
